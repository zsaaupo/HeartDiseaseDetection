# Copy this file to .env and adjust values as needed.
# The app will work fine with the defaults below for local development.

# Django secret key. Generate a real one for any non-local deployment, e.g.:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-04)3%_e86auhbs63=fn4m$

# Set to False in production.
DJANGO_DEBUG=True

# Comma-separated list of allowed hosts.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Header Django should trust when HTTPS is handled by a proxy such as Render.
DJANGO_SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Comma-separated list of trusted origins for CSRF checks.
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.domian.com
